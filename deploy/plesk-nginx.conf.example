# Plesk Linux only. Review generated vhost configuration before applying.
# Disable Proxy mode and direct static-file serving for this app domain first.
# Merge with existing location / rather than creating a duplicate.
client_max_body_size 302m;
client_body_timeout 30s;
access_log off;
location / {
    proxy_pass http://127.0.0.1:8088;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 45s;
}
