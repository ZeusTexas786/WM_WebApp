# Pilot-only fragment: review against this DOMAIN generated nginx config first.
# Keep the existing marketing location / and all other domains untouched.
# Replace REVIEWED_RELEASE with an immutable installed release directory.
location ^~ /static/recruiting/ {
    alias /opt/webmonkie/releases/REVIEWED_RELEASE/app/recruiting/static/recruiting/;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
}

location ^~ /dashboard/ {
    client_max_body_size 1100k;
    client_body_timeout 15s;
    proxy_request_buffering on;
    proxy_pass http://127.0.0.1:8089;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 45s;
    access_log off;
}

