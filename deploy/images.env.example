# Supply reviewed immutable references; do not use floating tags for a release.
PYTHON_IMAGE=python@sha256:REPLACE_WITH_REVIEWED_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_REVIEWED_DIGEST
NGINX_IMAGE=nginx@sha256:REPLACE_WITH_REVIEWED_DIGEST
CLAMAV_IMAGE=clamav/clamav@sha256:REPLACE_WITH_REVIEWED_DIGEST
WEBMONKIE_ENV_FILE=/etc/webmonkie/production.env
WEBMONKIE_PRIVATE_DIR=/srv/webmonkie/private
# Different from the Django application's POSTGRES_PASSWORD; bootstrap only.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
