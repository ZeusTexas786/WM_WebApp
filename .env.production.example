# Provision these through the VPS secret store/environment, never commit real values.
DJANGO_SETTINGS_MODULE=config.production
WEBMONKIE_LOCAL=0
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=app.your-domain.example
PUBLIC_ORIGIN=https://app.your-domain.example
POSTGRES_DB=webmonkie
POSTGRES_USER=webmonkie
POSTGRES_PASSWORD=
POSTGRES_HOST=database
POSTGRES_PORT=5432
PRIVATE_ROOT=/srv/webmonkie/private
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AI_API_KEY=
AI_EXTRACT_MODEL=gpt-5.4-mini
AI_ASSESS_MODEL=gpt-5.4
AI_MAX_DAILY_REQUESTS=100
SCANNER_HOST=scanner
SCANNER_PORT=3310
PARSER_SOCKET=/run/parser/parser.sock
ARCHIVE_KEY=
TRUSTED_PROXY_NETWORKS=172.30.0.0/24
LIFECYCLE_EXECUTION_ENABLED=0
