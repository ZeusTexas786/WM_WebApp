# Copy to .env locally. Never paste keys into chat or commit .env.
WEBMONKIE_LOCAL=1
AI_API_KEY=
AI_EXTRACT_MODEL=gpt-5.4-mini
AI_ASSESS_MODEL=gpt-5.4
AI_MAX_DAILY_REQUESTS=100
# Set a provider project spending limit before enabling live analysis.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WebMonkie <no-reply@your-verified-domain.example>
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Production only; use a fresh random secret and exact public hostname.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
